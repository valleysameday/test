// ======================================
// DELETE BUSINESS MODULE
// ======================================

export async function deleteBusiness({
    auth,
    businessId
}) {

    if (!businessId) {

        console.error(
            "[DELETE] No business ID supplied"
        );

        return;

    }


    const confirmed = confirm(
        "Final warning.\n\nAre you sure you want to permanently delete this business?"
    );


    if (!confirmed) {
        return;
    }


    try {

        console.log(
            "[DELETE] Starting:",
            businessId
        );


        const token =
            await auth.currentUser.getIdToken();


        const res = await fetch(
            "/.netlify/functions/deleteBusiness",
            {
                method: "POST",

                headers: {

                    "Content-Type":
                        "application/json",

                    "Authorization":
                        `Bearer ${token}`

                },

                body: JSON.stringify({

                    id: businessId

                })

            }
        );


        const data =
            await res.json();


        if (!res.ok) {

            throw new Error(
                data.error ||
                "Delete failed"
            );

        }


        console.log(
            "[DELETE] Success:",
            data
        );


        alert(
            "Business deleted successfully."
        );


        window.location.reload();


    } catch(err) {


        console.error(
            "[DELETE ERROR]",
            err
        );


        alert(
            "Failed to delete business."
        );

    }

}
